APP_NAME=MiniSystems
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://minisystems.test

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=minisystems
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Groq IA para System Images
GROQ_API_KEY= ""
GROQ_BASE_URL="https://api.groq.com/openai/v1"
GROQ_VISION_MODEL="openai/gpt-oss-120b"
GROQ_TEXT_MODEL="openai/gpt-oss-120b"

GROQ_TIMEOUT=120
GROQ_CONNECT_TIMEOUT=15

GROQ_SOCIAL_MAX_IMAGES=10
GROQ_VISION_BATCH_SIZE=5
GROQ_PREVIEW_MAX_BYTES=400000

GROQ_SOCIAL_MAX_OUTPUT_TOKENS=5000
GROQ_DAILY_LIMIT_PER_USER=30

GROQ_QUEUE="ai-social"
GROQ_TEMPORARY_RETENTION_HOURS=24
GROQ_STORE_RAW_RESPONSE=true


VITE_APP_NAME="${APP_NAME}"


# System Images - carga progresiva y cola
# 0 = sin límite fijo de lote. Las descargas se dividen en ZIPs por partes.
SYSTEM_IMAGES_MAX_FILES=0
SYSTEM_IMAGES_MAX_FILE_KB=20480
SYSTEM_IMAGES_UPLOAD_CONCURRENCY=3
SYSTEM_IMAGES_QUEUE_CONNECTION=database
SYSTEM_IMAGES_QUEUE=system-images
SYSTEM_IMAGES_RETENTION_HOURS=24
SYSTEM_IMAGES_STALE_MINUTES=30
SYSTEM_IMAGES_ZIP_PART_MAX_FILES=100
SYSTEM_IMAGES_ZIP_PART_MAX_MB=500

# Optimizador de imágenes - carga progresiva y cola
# 0 = sin límite fijo de lote. Las descargas se dividen en ZIPs por partes.
IMAGE_OPTIMIZER_MAX_FILES=0
IMAGE_OPTIMIZER_MAX_FILE_KB=20480
IMAGE_OPTIMIZER_UPLOAD_CONCURRENCY=2
IMAGE_OPTIMIZER_QUEUE_CONNECTION=database
IMAGE_OPTIMIZER_QUEUE=image-optimizer
IMAGE_OPTIMIZER_RETENTION_HOURS=24
IMAGE_OPTIMIZER_STALE_MINUTES=30
IMAGE_OPTIMIZER_ZIP_PART_MAX_FILES=100
IMAGE_OPTIMIZER_ZIP_PART_MAX_MB=500
